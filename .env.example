# Local defaults for WordPress development. Production values should live in
# server secrets or a shared production .env outside the release directory.

WP_ENVIRONMENT_TYPE=local
WP_HOME=http://localhost/wordpress
WP_SITEURL=http://localhost/wordpress
WP_CACHE=true
WP_DEBUG=false
DISABLE_WP_CRON=true
DISALLOW_FILE_MODS=false
AUTOMATIC_UPDATER_DISABLED=false
WP_AUTO_UPDATE_CORE=minor

DB_NAME=mcmenu
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_CHARSET=utf8
DB_COLLATE=
DB_TABLE_PREFIX=wp_

AUTH_KEY=local-auth-key-change-me
SECURE_AUTH_KEY=local-secure-auth-key-change-me
LOGGED_IN_KEY=local-logged-in-key-change-me
NONCE_KEY=local-nonce-key-change-me
AUTH_SALT=local-auth-salt-change-me
SECURE_AUTH_SALT=local-secure-auth-salt-change-me
LOGGED_IN_SALT=local-logged-in-salt-change-me
NONCE_SALT=local-nonce-salt-change-me
WP_CACHE_KEY_SALT=local-cache-key-salt-change-me

# SEO rollout flags.
MCPRICES_ENABLE_CANONICAL_REDIRECTS=false
