# Store the real production copy outside the release tree, for example:
# /home/u913239002/domains/mcdomenuusa.com/deploy/shared/.env

WP_ENVIRONMENT_TYPE=production
WP_HOME=https://mcdomenuusa.com
WP_SITEURL=https://mcdomenuusa.com
WP_CACHE=true
WP_DEBUG=false
DISABLE_WP_CRON=false
DISALLOW_FILE_MODS=true
AUTOMATIC_UPDATER_DISABLED=true
WP_AUTO_UPDATE_CORE=false

DB_NAME=replace_with_hostinger_database
DB_USER=replace_with_hostinger_user
DB_PASSWORD=replace_with_hostinger_password
DB_HOST=localhost
DB_CHARSET=utf8
DB_COLLATE=
DB_TABLE_PREFIX=wp_

AUTH_KEY=replace_with_unique_secret
SECURE_AUTH_KEY=replace_with_unique_secret
LOGGED_IN_KEY=replace_with_unique_secret
NONCE_KEY=replace_with_unique_secret
AUTH_SALT=replace_with_unique_secret
SECURE_AUTH_SALT=replace_with_unique_secret
LOGGED_IN_SALT=replace_with_unique_secret
NONCE_SALT=replace_with_unique_secret
WP_CACHE_KEY_SALT=replace_with_unique_secret

# Keep false during the noindex observation window. Set true only when the
# same-intent loser URLs are ready to become 301 redirects.
MCPRICES_ENABLE_CANONICAL_REDIRECTS=false
